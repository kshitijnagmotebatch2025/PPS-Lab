def incDate(d, m, y):
    if m < 1 or m > 12 or y <= 0:
        return "Invalid Date"

    if (y % 400 == 0) or (y % 4 == 0 and y % 100 != 0):
        leap = True
    else:
        leap = False

    if m in [1, 3, 5, 7, 8, 10, 12]:
        max_day = 31
    elif m in [4, 6, 9, 11]:
        max_day = 30
    elif m == 2:
        max_day = 29 if leap else 28

    if d < 1 or d > max_day:
        return "Invalid Date"

    d += 1
    if d > max_day:
        d = 1
        m += 1
        if m > 12:
            m = 1
            y += 1

    return "{:02d}-{:02d}-{:04d}".format(d, m, y)


day = int(input())
month = int(input())
year = int(input())

print(incDate(day, month, year))
