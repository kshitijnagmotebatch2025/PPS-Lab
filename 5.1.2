a, b, c, d = input().split()
marks = [int(a), int(b), int(c), int(d)]
total = 0
for p in marks:
	total += p
print(total)
percentage = (total / 400.0) * 100.0
print(f"{percentage:.2f}")
if percentage > 75:
	print("Distinction")
elif percentage >= 60:
	print("First Division")
elif percentage >= 50:
	print("Second Division")
elif percentage >= 40:
	print("Third Division")
else:
	print("Fail")
